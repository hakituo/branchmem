  {
   "id": "multi_platform_same_continuity",
   "description": "Two conversations declared as one continuity: same continuity_id, separate trees, separate anchors",
   "conversation_id": "conv-web",
   "events": [
    {
     "event_id": "p-a1",
     "client_node_id": "pa1",
     "role": "user",
     "content": "App 上说的",
     "timestamp": 100.0,
     "turn_id": "ta1",
     "event_type": "chat_message",
     "conversation_id": "conv-web"
    },
    {
     "event_id": "q-b1",
     "client_node_id": "qb1",
     "role": "user",
     "content": "QQ 上说的",
     "timestamp": 200.0,
