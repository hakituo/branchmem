     "timestamp": 100.0,
     "turn_id": "t1",
     "event_type": "chat_message"
    },
    {
     "event_id": "e-dup-copy",
     "idempotency_key": "dup-key-1",
     "client_node_id": "n1",
     "role": "user",
     "content": "只发一次",
     "timestamp": 100.5,
     "turn_id": "t1",
     "event_type": "chat_message"
    }
   ],
   "expect": {
    "topology_status": "complete",
    "event_count_in_tree": 1
   }
  },
