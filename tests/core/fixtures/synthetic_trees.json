{
 "version": 1,
 "description": "Synthetic message-tree fixtures (fictional content only) for branch visibility, deterministic topology and provenance.",
 "cases": [
  {
   "id": "sibling_isolation",
   "description": "Shared ancestors and two sibling branches: with the anchor on B, C and notes derived from C are hidden",
   "conversation_id": "conv-main",
   "events": [
    {
     "event_id": "e-root",
     "client_node_id": "n-root",
     "role": "user",
     "content": "我们周末去爬山吧",
     "timestamp": 100.0,
     "turn_id": "t-root",
     "event_type": "chat_message"
    },
    {
     "event_id": "e-a",
     "client_node_id": "n-a",
     "parent_node_id": "n-root",
     "role": "assistant",
     "content": "好啊，几点出发",
     "timestamp": 110.0,
     "turn_id": "t-a",
     "event_type": "chat_reply"
    },
    {
     "event_id": "e-b",
     "client_node_id": "n-b",
     "parent_node_id": "n-a",
     "role": "user",
     "content": "八点，带点吃的",
     "timestamp": 200.0,
     "turn_id": "t-b",
     "event_type": "chat_message"
    },
    {
     "event_id": "e-b2",
     "client_node_id": "n-b2",
     "parent_node_id": "n-b",
     "role": "assistant",
     "content": "那我带三明治",
     "timestamp": 210.0,
     "turn_id": "t-b2",
     "event_type": "chat_reply"
    },
    {
     "event_id": "e-c",
     "client_node_id": "n-c",
     "parent_node_id": "n-a",
     "role": "user",
     "content": "算了，改成看电影",
     "timestamp": 300.0,
     "turn_id": "t-c",
     "event_type": "chat_message"
    },
    {
     "event_id": "e-c2",
     "client_node_id": "n-c2",
     "parent_node_id": "n-c",
     "role": "assistant",
     "content": "好，那看七点场",
     "timestamp": 310.0,
     "turn_id": "t-c2",
     "event_type": "chat_reply"
    }
   ],
   "notes": [
    {
     "note_id": "note-main",
     "visibility": "tree_local",
     "namespace": "role_a",
     "source_event_ids": [
      "e-b",
      "e-b2"
     ]
    },
    {
     "note_id": "note-sibling",
     "visibility": "tree_local",
     "namespace": "role_a",
     "source_event_ids": [
      "e-c",
      "e-c2"
     ]
    }
   ],
   "expect": {
    "topology_status": "complete",
    "order_independent": true,
    "visible_event_ids": {
     "n-b2": [
      "e-root",
      "e-a",
      "e-b",
      "e-b2"
     ]
    },
    "note_visible": {
     "n-b2": {
      "note-main": true,
      "note-sibling": false
     }
    }
   }
  },
  {
   "id": "child_before_parent",
   "description": "A child arrives before its parent: pending, then replayed by topology; result is order independent",
   "conversation_id": "conv-main",
   "events": [
    {
     "event_id": "e2",
     "client_node_id": "n2",
     "parent_node_id": "n1",
     "role": "assistant",
     "content": "第二句",
     "timestamp": 120.0,
     "turn_id": "t2",
     "event_type": "chat_reply"
    },
    {
     "event_id": "e1",
     "client_node_id": "n1",
     "parent_node_id": "n0",
     "role": "user",
     "content": "第一句",
     "timestamp": 100.0,
     "turn_id": "t1",
     "event_type": "chat_message"
    },
    {
     "event_id": "e0",
     "client_node_id": "n0",
     "role": "user",
     "content": "开场",
     "timestamp": 90.0,
     "turn_id": "t0",
     "event_type": "chat_message"
    }
   ],
   "expect": {
    "topology_status": "complete",
    "order_independent": true,
    "visible_event_ids": {
     "n2": [
      "e0",
      "e1",
      "e2"
     ]
    }
   }
  },
  {
