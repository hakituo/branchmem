# Copy to .env (not committed) and fill in. Read by `python -m branchbench` at start-up;
# variables already set in the environment win over this file.

# Answer model, rolling summary, branchmem extraction and Mem0's LLM (OpenAI-compatible)
BB_LLM_BASE_URL=https://api.deepseek.com/v1
BB_LLM_API_KEY=
BB_LLM_MODEL=deepseek-v4-flash

# Mem0 embedder (OpenAI-compatible embeddings endpoint)
BB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
BB_EMBED_API_KEY=
BB_EMBED_MODEL=BAAI/bge-m3
BB_EMBED_DIMS=1024
